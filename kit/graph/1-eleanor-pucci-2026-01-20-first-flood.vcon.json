{"vcon":"0.4.0","uuid":"0195a7c2-3e41-7d10-9b2a-4f1e8c0d5a31","created_at":"2026-01-20T14:40:59Z","subject":"First flood call: storm drain backup","parties":[{"tel":"+14015550142","name":"Eleanor Pucci","role":"resident"},{"tel":"+14015550101","name":"Kevin Medeiros","role":"clerk"}],"dialog":[{"type":"text","start":"2026-01-20T14:40:00Z","duration":4,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"City of Newport, Kevin speaking."},{"type":"text","start":"2026-01-20T14:40:06Z","duration":11,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Hi, this is Eleanor Pucci, at the end of Thames Street in the Fifth Ward. The storm drain on my corner backed up in yesterday's storm and I have water in my basement."},{"type":"text","start":"2026-01-20T14:40:19Z","duration":4,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"I'm sorry to hear that. Is anyone hurt, or any water near electrical?"},{"type":"text","start":"2026-01-20T14:40:25Z","duration":4,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"No, nobody's hurt. It's just a mess. Boxes, the washer, all of it."},{"type":"text","start":"2026-01-20T14:40:31Z","duration":8,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Okay. I'm opening a request for Public Works to look at the drain. Someone will call you back this week to set up a time."},{"type":"text","start":"2026-01-20T14:40:41Z","duration":4,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"This week. All right."},{"type":"text","start":"2026-01-20T14:40:47Z","duration":4,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Anything else I can help with today?"},{"type":"text","start":"2026-01-20T14:40:53Z","duration":4,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"No. Thank you, Kevin."}],"analysis":[],"attachments":[{"purpose":"tags","encoding":"json","start":"2026-01-20T14:40:00Z","party":0,"dialog":0,"body":["org:city-of-newport","department:public-works","resident:eleanor-pucci","location:lower-thames-street","step:first-call"]}]}