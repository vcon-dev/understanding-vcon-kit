{"vcon":"0.4.0","uuid":"0195a7c2-3e41-7d10-9b2a-4f1e8c0d5a02","created_at":"2026-03-10T15:13:00Z","subject":"Fraud alert, card verification, disputed charge","parties":[{"tel":"+16175550188","name":"Priya Raman","role":"customer"},{"tel":"+18005550199","name":"Harborline Bank fraud services","role":"agent"}],"dialog":[{"type":"text","start":"2026-03-10T15:02:00Z","duration":44,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Thank you for calling Harborline Bank fraud services. This call is recorded for fraud investigation and quality. Do you agree to the recording?"},{"type":"text","start":"2026-03-10T15:02:52Z","duration":17,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Yes, that's fine."},{"type":"text","start":"2026-03-10T15:03:19Z","duration":17,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Thank you. Who am I speaking with?"},{"type":"text","start":"2026-03-10T15:03:45Z","duration":17,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Priya Raman. I got a text saying there was possible fraud on my card."},{"type":"text","start":"2026-03-10T15:04:12Z","duration":30,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"I can help with that. To verify you, can you read me the full card number on the front of the card?"},{"type":"text","start":"2026-03-10T15:04:51Z","duration":17,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Sure. 4111 1111 1111 1111."},{"type":"text","start":"2026-03-10T15:05:18Z","duration":17,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"And the last four of your Social Security number?"},{"type":"text","start":"2026-03-10T15:05:44Z","duration":17,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"4821."},{"type":"text","start":"2026-03-10T15:06:10Z","duration":44,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Thank you, you're verified. I see a payment of eight hundred and twelve dollars to a medical billing service on the third. Do you recognize it?"},{"type":"text","start":"2026-03-10T15:07:03Z","duration":44,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Yes, that's mine. I was in the hospital last month, that's the bill. I know it's not what I usually spend, which is probably why it got flagged."},{"type":"text","start":"2026-03-10T15:07:56Z","duration":39,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"That makes sense. I'll mark it as legitimate. There's also a forty-nine dollar online charge from yesterday I want to ask you about."},{"type":"text","start":"2026-03-10T15:08:44Z","duration":17,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"No. I didn't make that one."},{"type":"text","start":"2026-03-10T15:09:11Z","duration":70,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Okay. I'm blocking this card now and issuing a new one, it will arrive in five to seven business days. A fraud specialist will call you back within two business days to finish the dispute. Is this number the best one to reach you?"},{"type":"text","start":"2026-03-10T15:10:30Z","duration":17,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Yes, this number. Please don't use my email for this."},{"type":"text","start":"2026-03-10T15:10:56Z","duration":35,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Noted, phone only. Before you go, we sometimes send offers on new card products. Would you like to hear about those?"},{"type":"text","start":"2026-03-10T15:11:40Z","duration":26,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"No thank you. And I don't want this call used for anything except sorting out the fraud."},{"type":"text","start":"2026-03-10T15:12:16Z","duration":17,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Understood. I've noted that on the call. Anything else today?"},{"type":"text","start":"2026-03-10T15:12:42Z","duration":17,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"No, that's it. Thank you."}],"analysis":[],"attachments":[{"purpose":"lawful_basis","start":"2026-03-10T15:02:52Z","party":0,"dialog":1,"encoding":"json","body":{"lawful_basis":"consent","expiration":"2027-03-10T15:02:00Z","purpose_grants":[{"purpose":"recording","granted":true,"granted_at":"2026-03-10T15:02:52Z"},{"purpose":"transcription","granted":true,"granted_at":"2026-03-10T15:02:52Z"},{"purpose":"fraud_investigation","granted":true,"granted_at":"2026-03-10T15:02:52Z"},{"purpose":"customer_callback","granted":true,"granted_at":"2026-03-10T15:02:52Z","conditions":["phone only, no email"]},{"purpose":"marketing","granted":false,"granted_at":"2026-03-10T15:11:40Z"},{"purpose":"model_training","granted":false,"granted_at":"2026-03-10T15:11:40Z"},{"purpose":"quality_review","granted":false,"granted_at":"2026-03-10T15:11:40Z"}],"proof_mechanisms":[{"proof_type":"verbal_confirmation","timestamp":"2026-03-10T15:02:52Z","proof_data":{"dialog_reference":1,"confirmation_text":"Yes, that's fine."}},{"proof_type":"verbal_confirmation","timestamp":"2026-03-10T15:11:40Z","proof_data":{"dialog_reference":15,"confirmation_text":"I don't want this call used for anything except sorting out the fraud."}}],"status_interval":"30d"}},{"purpose":"tags","encoding":"json","start":"2026-03-10T15:02:00Z","party":0,"dialog":0,"body":["org:harborline-bank","department:fraud-services"]}],"extensions":["lawful_basis"]}