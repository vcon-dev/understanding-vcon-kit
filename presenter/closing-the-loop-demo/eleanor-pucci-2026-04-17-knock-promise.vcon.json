{"vcon":"0.4.0","uuid":"0195a7c2-3e41-7d10-9b2a-4f1e8c0d5a21","created_at":"2026-04-17T19:13:02Z","subject":"Drainage rebuild: knock before digging","parties":[{"tel":"+14015550142","name":"Eleanor Pucci","role":"resident"},{"tel":"+14015550100","name":"Dana Ferreira","role":"clerk"}],"dialog":[{"type":"text","start":"2026-04-17T19:12:00Z","duration":4,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Public Works, this is Dana."},{"type":"text","start":"2026-04-17T19:12:06Z","duration":10,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Dana, it's Eleanor Pucci on Thames Street. I got the notice that you're finally fixing the drain. Thank you. When are they digging up my street?"},{"type":"text","start":"2026-04-17T19:12:18Z","duration":5,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"The rebuild starts Monday. Your block is on the schedule for Thursday."},{"type":"text","start":"2026-04-17T19:12:25Z","duration":8,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"My car's in that driveway and I'm home with my mother. Can someone knock before they start, so I can move the car?"},{"type":"text","start":"2026-04-17T19:12:35Z","duration":7,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Yes. I'll make sure the crew knocks on your door before they dig. Marcus is the crew lead on your block."},{"type":"text","start":"2026-04-17T19:12:44Z","duration":4,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Thursday, and they knock first."},{"type":"text","start":"2026-04-17T19:12:50Z","duration":4,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Thursday, and they knock first. You have my word."},{"type":"text","start":"2026-04-17T19:12:56Z","duration":4,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Thank you, Dana. Have a good weekend."}],"analysis":[],"attachments":[{"purpose":"tags","encoding":"json","start":"2026-04-17T19:12:00Z","party":0,"dialog":0,"body":["org:city-of-newport","department:public-works","project:drainage-rebuild-fifth-ward"]}]}