{"vcon":"0.4.0","uuid":"0195a7c2-3e41-7d10-9b2a-4f1e8c0d5a22","created_at":"2026-04-23T11:05:40Z","subject":"Drainage rebuild: crew at the door","parties":[{"tel":"+14015550175","name":"Marcus","role":"crew_lead"},{"tel":"+14015550142","name":"Eleanor Pucci","role":"resident"}],"dialog":[{"type":"text","start":"2026-04-23T11:05:00Z","duration":11,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Mrs. Pucci? It's Marcus with Public Works. We're out front. I was told to give you a knock before we dig, so this is me knocking by phone and at the door."},{"type":"text","start":"2026-04-23T11:05:13Z","duration":4,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Oh, good, thank you. Let me move my car."},{"type":"text","start":"2026-04-23T11:05:19Z","duration":7,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Take your time. We'll start once the driveway's clear. Should be done with your stretch by Monday."},{"type":"text","start":"2026-04-23T11:05:28Z","duration":4,"parties":[1],"originator":1,"mediatype":"text/plain","encoding":"none","body":"Thank you for remembering."},{"type":"text","start":"2026-04-23T11:05:34Z","duration":4,"parties":[0],"originator":0,"mediatype":"text/plain","encoding":"none","body":"Of course."}],"analysis":[],"attachments":[{"purpose":"tags","encoding":"json","start":"2026-04-23T11:05:00Z","party":0,"dialog":0,"body":["org:city-of-newport","department:public-works","project:drainage-rebuild-fifth-ward"]}]}